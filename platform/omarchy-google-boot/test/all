#!/bin/bash
# What can be checked without the device: the entrypoint shapes the dispatcher
# trusts, the staged layout (including the files the builder stages from
# extra.list), that the device-side lib reaches the same conclusions as the build
# host's from the same deviceinfo, and that the hook is shaped like an ALPM hook.
# Run by the PKGBUILD's check() and by hand.
set -euo pipefail

addon="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The repository, when it is visible: inside a build chroot the recipe is staged
# on its own, so the parent directories are not the repository.
repo=""
candidate="$(cd "$addon/../.." 2>/dev/null && pwd || true)"
if [ -n "$candidate" ] && [ -f "$candidate/boot/lib.sh" ] &&
	[ -f "$candidate/devices/google-asurada/deviceinfo" ]; then
	repo="$candidate"
fi
rc=0

ok() { printf '  ok   %s\n' "$*"; }
no() { printf '  FAIL %s\n' "$*" >&2; rc=1; }

# ---------------------------------------------------------------------------
# The entrypoints the dispatcher execs (docs/recon.md §11)
# ---------------------------------------------------------------------------
for entry in setup-boot update-verify; do
	file="$addon/entrypoints/$entry"
	if [ -f "$file" ] && [ -x "$file" ]; then
		ok "entrypoint $entry is a regular executable file"
	else
		no "entrypoint $entry is missing or not executable"
	fi
	mode="$(stat -c '%a' "$file")"
	if [ $((8#$mode & 8#022)) -eq 0 ]; then
		ok "entrypoint $entry mode $mode has no group/other write bits"
	else
		no "entrypoint $entry mode $mode is writable by group or other"
	fi
	if [ "$(head -n1 "$file")" = '#!/bin/bash -p' ]; then
		ok "entrypoint $entry shebang is '#!/bin/bash -p'"
	else
		no "entrypoint $entry shebang must be '#!/bin/bash -p'"
	fi
done

# ---------------------------------------------------------------------------
# Everything shipped is a script that parses
# ---------------------------------------------------------------------------
for script in install test/all \
	entrypoints/setup-boot entrypoints/update-verify \
	usr/bin/omarchy-google-boot usr/lib/omarchy/google-boot/lib.sh; do
	if bash -n "$addon/$script"; then
		ok "bash -n $script"
	else
		no "bash -n $script"
	fi
done

# ---------------------------------------------------------------------------
# The staged layout: what pacman will actually see
# ---------------------------------------------------------------------------
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
# Only what install reads: copying the whole directory would drag along
# makepkg's own staging directory ($startdir/pkg, which is unreadable by design).
mkdir -p "$scratch/pkg"
cp -a "$addon/install" "$addon/extra.list" "$addon/usr" "$addon/entrypoints" "$scratch/pkg/"
if [ -d "$addon/extra" ]; then
	cp -a "$addon/extra" "$scratch/pkg/"
fi

# Inside a build chroot the builder has already staged extra/ (extra.list);
# from the repository it does not exist yet, so stage it here the same way. Both
# paths then exercise the real install script.
if [ ! -d "$scratch/pkg/extra" ]; then
	if [ -z "$repo" ]; then
		no 'no extra/ to install from, and no repository to stage it from'
		exit "$rc"
	fi
	while read -r path; do
		path="${path%%#*}"
		path="$(printf '%s' "$path" | tr -d '[:space:]')"
		[ -n "$path" ] || continue
		if [ ! -e "$repo/$path" ]; then
			no "extra.list names a missing path: $path"
			continue
		fi
		mkdir -p "$scratch/pkg/extra/$(dirname "$path")"
		cp -a "$repo/$path" "$scratch/pkg/extra/$(dirname "$path")/"
	done <"$scratch/pkg/extra.list"
fi

"$scratch/pkg/install" "$scratch/root"

for path in \
	usr/bin/omarchy-google-boot \
	usr/lib/omarchy/google-boot/setup-boot \
	usr/lib/omarchy/google-boot/update-verify \
	usr/lib/omarchy/google-boot/lib.sh \
	usr/lib/omarchy/google-boot/lib-cgpt.sh \
	usr/lib/omarchy/google-boot/make-kpart.sh \
	usr/lib/omarchy/google-boot/install-kpart.sh \
	usr/lib/omarchy/google-boot/deviceinfo \
	usr/lib/omarchy/google-boot/kernel-cmdline.conf \
	usr/lib/omarchy/google-boot/devkeys/kernel.keyblock \
	usr/lib/omarchy/google-boot/devkeys/kernel_subkey.vbpubk \
	usr/lib/omarchy/google-boot/devkeys/kernel_data_key.vbprivk \
	usr/share/libalpm/hooks/99-omarchy-kpart.hook; do
	if [ -f "$scratch/root/$path" ]; then
		ok "stages $path"
	else
		no "does not stage $path"
	fi
done
for path in setup-boot update-verify; do
	if [ -x "$scratch/root/usr/lib/omarchy/google-boot/$path" ]; then
		ok "the staged $path is executable"
	else
		no "the staged $path is not executable"
	fi
done

# Nothing may land outside the two trees pacman expects here.
tops="$(find "$scratch/root" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | tr '\n' ' ')"
if [ "$tops" = 'usr ' ]; then
	ok "the package root holds only usr/ ($tops)"
else
	no "unexpected top-level entries: ${tops:-none}"
fi

# ---------------------------------------------------------------------------
# The packaged lib reaches the same conclusions as the build host's
# ---------------------------------------------------------------------------
# This package replaces scripts/lib.sh with a device-side lib.sh, so both have to
# read the same deviceinfo and derive the same facts. Skipped where the
# repository is not visible (a build chroot): there the hash over extra.list is
# what keeps them in step.
if [ -n "$repo" ]; then
	fields='"$DEVICE" "$DTB_GLOB" "$DEPTHCHARGE_BOARD" "$DEPTHCHARGE_COMPRESSION" "$KPART_START_SECTORS" "$KPART_SIZE_SECTORS" "$BOOT_SIZE_MIB" "$BOOT_FS"'
	packaged="$(BUILD_ROOT="$scratch/build" WORK_DIR="$scratch/work" bash -c \
		". \"\$1\"/lib.sh; printf '%s\\n' $fields" _ "$scratch/root/usr/lib/omarchy/google-boot")"
	host="$(BUILD_ROOT="$scratch/build" WORK_DIR="$scratch/work" SRC_DIR="$scratch/src" bash -c \
		". \"\$1\"/boot/lib.sh; printf '%s\\n' $fields" _ "$repo")"
	if [ "$packaged" = "$host" ]; then
		ok 'the packaged lib derives the same device facts as boot/lib.sh'
	else
		no "the packaged lib disagrees with boot/lib.sh:
--- packaged
$packaged
--- host
$host"
	fi
else
	ok 'skipped the packaged-vs-host lib comparison (no repository visible)'
fi

# ---------------------------------------------------------------------------
# The ALPM hook
# ---------------------------------------------------------------------------
hook="$scratch/root/usr/share/libalpm/hooks/99-omarchy-kpart.hook"
if grep -qx '\[Trigger\]' "$hook" &&
	grep -qx '\[Action\]' "$hook" &&
	grep -qx 'When = PostTransaction' "$hook" &&
	grep -qx 'Exec = /usr/bin/omarchy-google-boot kpart-rewrite' "$hook" &&
	grep -qx 'Target = linux-omarchy-book' "$hook"; then
	ok 'the hook triggers on the kernel package and acts after the transaction'
else
	no 'the hook is not shaped like an ALPM hook (Trigger/Action, PostTransaction, kernel target, Exec)'
fi
# pacman's INI parser keeps the last value of a repeated key, so two Type lines in
# one [Trigger] section silently drop the first (with a warning at install time).
# The package and path conditions must live in separate sections.
if awk '
	/^\[Trigger\]/ { section = 1; types = 0; next }
	/^\[Action\]/  { section = 0; next }
	section && /^Type[[:space:]]*=/ { types++ }
	END { exit (types > 1) }
' "$hook"; then
	ok 'each [Trigger] section has at most one Type'
else
	no 'a [Trigger] section repeats Type, which pacman silently overwrites'
fi
# The number is what puts it after mkinitcpio's own hook.
case "${hook##*/}" in
99-*) ok "the hook name sorts after mkinitcpio's (${hook##*/})" ;;
*) no "the hook must be numbered 99 to run after mkinitcpio's" ;;
esac

# ---------------------------------------------------------------------------
# The chroot guard
# ---------------------------------------------------------------------------
# The Debian original's guard never fired (stat without -L reports the procfs
# symlink itself), so this is checked rather than assumed: the shared helpers
# exist, dereference, and are what the scripts use.
staged_boot="$scratch/root/usr/lib/omarchy/google-boot"
if grep -q 'in_chroot()' "$staged_boot/lib-cgpt.sh" &&
	grep -q 'require_real_root()' "$staged_boot/lib-cgpt.sh" &&
	grep -q 'stat -Lc' "$staged_boot/lib-cgpt.sh"; then
	ok 'lib-cgpt.sh defines in_chroot and require_real_root with a dereferencing stat'
else
	no 'lib-cgpt.sh must define in_chroot/require_real_root and use stat -L'
fi
if grep -qE '^[[:space:]]*require_real_root$' "$staged_boot/install-kpart.sh"; then
	ok 'install-kpart.sh refuses to run from a chroot'
else
	no 'install-kpart.sh does not call require_real_root'
fi
command_file="$scratch/root/usr/bin/omarchy-google-boot"
if grep -qE '^[[:space:]]*require_real_root$' "$command_file"; then
	ok 'setup-boot and update-verify refuse to run from a chroot'
else
	no '/usr/bin/omarchy-google-boot must call require_real_root'
fi
# The hook's branch is the exception, and deliberately so: it fires inside
# pacman transactions, including the image build, where a failure would abort
# the transaction. It must skip instead of dying.
if awk '
	/^kpart-rewrite\)/ { inside = 1 }
	/^[[:space:]]*;;/ { inside = 0 }
	inside && /in_chroot/ { found = 1 }
	END { exit !found }
' "$command_file"; then
	ok 'kpart-rewrite skips (instead of failing) inside a chroot'
else
	no 'kpart-rewrite must check in_chroot so the ALPM hook cannot break a transaction'
fi
# And the helpers must behave outside a chroot, where the tests run.
if ( die() { printf 'ERROR: %s\n' "$*" >&2; return 1; }
	. "$staged_boot/lib-cgpt.sh" && ! in_chroot && require_real_root ); then
	ok 'require_real_root passes outside a chroot'
else
	no 'require_real_root refuses outside a chroot'
fi

# ---------------------------------------------------------------------------
# The platform check
# ---------------------------------------------------------------------------
# The ALPM hook calls the command directly, with no useful PATH, so the detector
# has to be resolved by path -- the first version called it bare and the hook
# reported "not an aarch64-google machine" during an image build (recon §12).
if grep -q 'detector=.*omarchy-hw-aarch64-google' "$command_file" &&
	! grep -qE '^[[:space:]]*omarchy-hw-aarch64-google[[:space:]]*(\|\||&&|$)' "$command_file"; then
	ok 'the command finds the detector beside itself, not through PATH'
else
	no 'the command must resolve the detector by path (a hook has no useful PATH)'
fi
# "Cannot tell" is not "not Google": during an image build the hook runs before
# omarchy's runtime -- which ships the detector -- is installed, and a
# transaction must not fail over that. The hook warns and succeeds; the leaves
# the dispatcher calls may refuse.
if grep -q '^require_google_machine()' "$command_file" &&
	grep -q 'or its detector is not installed yet' "$command_file" &&
	grep -qE '^[[:space:]]*require_google_machine$' "$command_file"; then
	ok 'a missing detector is reported as such, and only the hook treats it as a skip'
else
	no 'the command must tell "cannot tell the platform" apart from "not a Google machine"'
fi

exit "$rc"
