#!/bin/bash -p
# omarchy-lifecycle-dispatch setup-boot -- the aarch64-google platform's side.
#
# The dispatcher execs this file directly and trusts it by shape, not by
# content: root-owned, a regular file, no group/other write bits (docs/recon.md
# §11). The work lives in /usr/bin/omarchy-book-boot, which can also be run by
# hand.
set -euo pipefail

exec /usr/bin/omarchy-book-boot setup-boot "$@"
