# Maintainer: omarchybook
# The Omarchy platform's boot chain for Google Chrome OS devices
# (aarch64-google): what the dispatcher's `setup-boot` and `update-verify`
# resolve to, and what rewrites the kernel partition after a kernel update
# (docs/plan.md Phase 5, docs/recon.md §10, §11).
#
# A Chrome OS device has no UEFI and no bootloader on disk: depthcharge loads a
# signed FIT from the GPT partition whose PARTUUID equals `kern_guid` in the
# kernel command line. A kernel update that only fills /boot and /lib/modules
# therefore changes nothing at the next boot, and the generic Limine path cannot
# drive this device at all -- so the platform owns the partition:
#
#   /usr/lib/omarchy/book-boot/setup-boot        the dispatcher's entrypoint
#   /usr/lib/omarchy/book-boot/update-verify     the other one
#   /usr/bin/omarchy-book-boot                   the work they share
#   /usr/lib/omarchy/book-boot/install-kpart.sh  resolve p1, verify, back up, write
#   /usr/lib/omarchy/book-boot/make-kpart.sh     build the signed FIT
#   /usr/lib/omarchy/book-boot/{lib.sh,lib-cgpt.sh,deviceinfo,kernel-cmdline.conf,devkeys/}
#   /usr/share/libalpm/hooks/99-omarchy-kpart.hook the trigger after a kernel change
#
# The boot chain is canonical in the repository's boot/ and the device facts in
# devices/google-asurada/; `extra.list` has the builder stage both, so this
# package carries no copy of either.

pkgname=omarchy-book-boot
pkgver=0.1.0
pkgrel=1
pkgdesc='Omarchy boot chain for Google Chrome OS devices (aarch64-google): a signed kpart in p1, rewritten after a kernel update'
arch=('aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
groups=('omarchy-platform-book')
# depthchargectl (depthcharge-tools) builds the FIT; futility and cgpt
# (vboot-utils) verify it and resolve the partition; the kernel package owns the
# vmlinuz, the DTBs and /lib/modules the FIT is built from.
depends=('depthcharge-tools' 'vboot-utils' 'linux-omarchy-book')
checkdepends=('bash' 'coreutils' 'findutils' 'grep' 'sed' 'util-linux')

package() {
	"$startdir/install" "$pkgdir"
}

check() {
	"$startdir/test/all"
}
