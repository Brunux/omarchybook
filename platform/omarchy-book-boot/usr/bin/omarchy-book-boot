#!/bin/bash
# omarchy-book-boot <setup-boot|update-verify|kpart-rewrite>
#
# The aarch64-google boot chain: what the two operations the dispatcher requires
# of this platform resolve to (docs/recon.md §11), and what the ALPM hook runs
# when the kernel package changes. A Chrome OS device loads its kernel from the
# GPT partition whose PARTUUID is the `kern_guid` in its own command line, so p1
# has to keep holding a signed FIT built from the installed kernel -- /boot and
# /lib/modules alone change nothing at the next boot.
#
#   setup-boot     first boot of a freshly written system: make p1 match the
#                  kernel this system is running. A card written from a rootfs
#                  tarball may carry an older kpart, or none.
#   update-verify  after an update: p1 must still hold a signed FIT, and the
#                  kernel and initramfs it was built from must still be there.
#   kpart-rewrite  the ALPM hook's action: the kernel changed, so rebuild p1
#                  now. CONFIRM is implied by the trigger.
#
# The three share one mechanic, deliberately: the partition is always resolved
# from kern_guid, so a card and the internal storage are each fixed in place and
# nothing has to be configured.
set -euo pipefail

boot_dir=/usr/lib/omarchy/book-boot
# shellcheck source=lib.sh
. "$boot_dir/lib.sh"
# shellcheck source=lib-cgpt.sh
. "$boot_dir/lib-cgpt.sh"

usage() {
	echo "Usage: ${0##*/} <setup-boot|update-verify|kpart-rewrite> [image-first-boot]" >&2
	exit 2
}

(( $# )) || usage
operation="$1"
shift

case "$operation" in
setup-boot | update-verify)
	# The hardware leaves call these with `image-first-boot`; nothing else.
	(( $# == 0 )) || { [ "$1" = image-first-boot ] && (( $# == 1 )) || usage; }
	;;
esac

(( EUID == 0 )) || die "must run as root"

# Never act on a machine this chain does not describe: a package that ends up on
# the wrong machine must not rewrite that machine's kernel partition. Same rule
# as bin/omarchy-lifecycle-dispatch: the detector is the sibling of this command
# (never whatever PATH finds, which a hook has no reason to provide), and root
# does not let its environment choose what runs.
#
# "Cannot tell" is not "not Google". The detectors ship with omarchy's runtime,
# which an image build installs *after* the device list -- and the device list is
# the transaction that installs the kernel package and runs this package's ALPM
# hook. A booted system always has them.
fixed_path=/usr/local/sbin:/usr/local/bin:/usr/bin
detector="$(dirname -- "$(readlink -f "$0")")/omarchy-hw-aarch64-google"
google_machine() {
	[ -x "$detector" ] || return 1
	if (( EUID == 0 )); then
		/usr/bin/env -i PATH="$fixed_path" "$detector" >/dev/null
	else
		"$detector" >/dev/null
	fi
}
require_google_machine() {
	[ -x "$detector" ] || die "no $detector: omarchy's platform detectors are not installed"
	google_machine || die "not an aarch64-google machine"
}

case "$operation" in
setup-boot)
	# First boot of a freshly written system. Only a booted system has the
	# kernel partition this is about, so a chroot is an error rather than a
	# skip: nobody runs the dispatcher's setup-boot inside one by accident.
	require_real_root
	require_google_machine
	# install-kpart.sh does the work: resolve p1 from kern_guid, build the FIT
	# from the running system, refuse a partition that is not a Chrome OS kernel
	# partition, back up what it replaces, write, then re-read it with futility.
	CONFIRM=yes "$boot_dir/install-kpart.sh"
	;;
kpart-rewrite)
	# The ALPM hook's action, so it fires inside transactions -- including the
	# one that builds an image, where there is no kernel partition to write and
	# /proc/cmdline describes the host. A failing PostTransaction hook would
	# break that transaction, so this branch reports and succeeds; the first
	# boot (setup-boot) is what writes p1 for the image it built.
	if in_chroot; then
		warn "not rewriting the kernel partition: running in a chroot, not the booted system"
		exit 0
	fi
	if ! google_machine; then
		warn "not rewriting the kernel partition: not an aarch64-google machine, or its detector is not installed yet"
		exit 0
	fi
	CONFIRM=yes "$boot_dir/install-kpart.sh"
	;;
update-verify)
	# Read-only, and as strong as it can honestly be without rebooting: the
	# kernel partition must verify as a dev-signed FIT, and the files it was
	# built from must still be installed (an update that removed them would
	# leave a kernel partition that boots a kernel with no modules). Again the
	# answer would be about the host in a chroot, so that is an error.
	require_real_root
	require_google_machine
	guid="$(sed -n 's/.*\<kern_guid=\([^ ]*\).*/\1/p' /proc/cmdline | head -1)"
	[ -n "$guid" ] || die "no kern_guid= in /proc/cmdline: this kernel was not loaded by depthcharge"
	part="$(findfs PARTUUID="$guid" 2>/dev/null || true)"
	[ -n "$part" ] || die "no partition with PARTUUID=$guid (from kern_guid in /proc/cmdline)"
	kpart_verify "$part"
	for rel in "$KERNEL_IMAGE_REL" "$INITRAMFS_REL"; do
		[ -f "/$rel" ] || die "missing /$rel, which the kernel partition boots from"
	done
	log "p1 holds a verified kernel for the running release ($KERNEL_RELEASE)"
	;;
*)
	usage
	;;
esac
