#!/bin/bash
# What can be checked without the device: that the entrypoint is shaped the way
# the dispatcher trusts, that the shell's data files parse, and that the setup
# command refuses what it does not understand. Run by the PKGBUILD's check() and
# by hand.
set -euo pipefail

addon="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
rc=0

ok() { printf '  ok   %s\n' "$*"; }
no() { printf '  FAIL %s\n' "$*" >&2; rc=1; }

# ---------------------------------------------------------------------------
# The entrypoint the dispatcher execs (docs/recon.md §11)
# ---------------------------------------------------------------------------
entry="$addon/entrypoints/setup-system"
if [ -f "$entry" ] && [ -x "$entry" ]; then
	ok 'entrypoint is a regular executable file'
else
	no 'entrypoint/ is missing or not executable'
fi
mode=$(stat -c '%a' "$entry")
if [ $(( 8#$mode & 8#022 )) -eq 0 ]; then
	ok "entrypoint mode $mode has no group/other write bits"
else
	no "entrypoint mode $mode is writable by group or other"
fi
if [ "$(head -n1 "$entry")" = '#!/bin/bash -p' ]; then
	ok "entrypoint shebang is '#!/bin/bash -p'"
else
	no "entrypoint shebang must be '#!/bin/bash -p'"
fi

# ---------------------------------------------------------------------------
# Everything shipped is either data or a script that parses
# ---------------------------------------------------------------------------
for script in install test/all entrypoints/setup-system usr/bin/omarchy-book-setup-system; do
	if bash -n "$addon/$script"; then
		ok "bash -n $script"
	else
		no "bash -n $script"
	fi
done

set +e
"$addon/usr/bin/omarchy-book-setup-system" bogus >/dev/null 2>&1
got=$?
set -e
if [ "$got" -eq 2 ]; then
	ok 'setup-system rejects an unknown argument with exit 2'
else
	no "setup-system exited $got for an unknown argument (want 2)"
fi

# ---------------------------------------------------------------------------
# The staged layout: what pacman will actually see
# ---------------------------------------------------------------------------
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
"$addon/install" "$scratch"

for path in \
	etc/keyd/default.conf \
	usr/share/omarchy-platform/key-names \
	usr/bin/omarchy-book-setup-system \
	usr/lib/omarchy/book/setup-system \
	usr/lib/udev/rules.d/90-brightnessctl.rules \
	usr/lib/systemd/journald.conf.d/10-omarchy-book.conf
do
	if [ -f "$scratch/$path" ]; then
		ok "stages $path"
	else
		no "does not stage $path"
	fi
done

# The entrypoint has to be executable where it lands.
if [ -x "$scratch/usr/lib/omarchy/book/setup-system" ]; then
	ok 'the staged entrypoint is executable'
else
	no 'the staged entrypoint is not executable'
fi

# And nothing may land outside those three trees (a stray copy puts files at the
# package root).
tops="$(find "$scratch" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | tr '\n' ' ')"
if [ "$tops" = 'etc usr ' ]; then
	ok "the package root holds only etc/ usr/ ($tops)"
else
	no "unexpected top-level entries: ${tops:-none}"
fi

# ---------------------------------------------------------------------------
# Platform data, against the formats its readers expect
# ---------------------------------------------------------------------------
keynames="$addon/usr/share/omarchy-platform/key-names"
if awk '
	/^[[:space:]]*(#|$)/ { next }
	NF != 2 { printf "not two fields: %s\n", $0 > "/dev/stderr"; bad = 1; next }
	$1 !~ /^[A-Za-z0-9_]+$/ || $2 !~ /^[A-Za-z0-9_]+$/ {
		printf "not a keysym/name: %s\n", $0 > "/dev/stderr"; bad = 1
	}
	END { exit bad + 0 }
' "$keynames"; then
	ok 'share/omarchy-platform/key-names parses as <keysym> <name>'
else
	no 'share/omarchy-platform/key-names does not parse'
fi

if awk '
	/^[[:space:]]*(#|$)/ { next }
	/^\[.+\][[:space:]]*$/ { next }
	/^[-k]?[0-9a-fA-F:]+[[:space:]]*$/ { next }
	/^[^=]+ = .*$/ { next }
	{ printf "unrecognised line: %s\n", $0 > "/dev/stderr"; bad = 1 }
	END { exit bad + 0 }
' "$addon/etc/keyd/default.conf"; then
	ok 'etc/keyd/default.conf has only sections, ids and mappings'
else
	no 'etc/keyd/default.conf has a line keyd would not understand'
fi

journald="$addon/usr/lib/systemd/journald.conf.d/10-omarchy-book.conf"
if grep -qx '\[Journal\]' "$journald"; then
	ok 'journald drop-in carries a [Journal] section'
else
	no 'journald drop-in has no [Journal] section'
fi

udev="$addon/usr/lib/udev/rules.d/90-brightnessctl.rules"
if awk '/^[[:space:]]*(#|$)/ { next } !/^ACTION==/ { printf "unrecognised rule: %s\n", $0 > "/dev/stderr"; bad = 1 } END { exit bad + 0 }' "$udev"; then
	ok 'the udev rule is a single ACTION== rule'
else
	no 'the udev rule does not start with ACTION=='
fi

exit "$rc"
