diff --git a/install/hardware/google/audio.sh b/install/hardware/google/audio.sh
new file mode 100644
index 0000000..2fc168f
--- /dev/null
+++ b/install/hardware/google/audio.sh
@@ -0,0 +1,9 @@
+# Google Chrome OS (aarch64-google) audio.
+#
+# The MT8192 card's routing lives in an ALSA UCM BootSequence, which alsa-lib
+# runs only on an explicit `set _boot`: alsactl restore (alsa-utils) drives it on
+# card add, and without it the only sink is a Dummy Output. pipewire-alsa gives
+# ALSA-only applications the default PCM.
+if omarchy-hw-aarch64-google; then
+  omarchy-pkg-add alsa-ucm-conf alsa-utils pipewire-alsa
+fi
diff --git a/install/hardware/google/boot.sh b/install/hardware/google/boot.sh
new file mode 100644
index 0000000..d9471a2
--- /dev/null
+++ b/install/hardware/google/boot.sh
@@ -0,0 +1,10 @@
+# Google Chrome OS (aarch64-google) boot prerequisites.
+#
+# A Chrome OS device boots a signed depthcharge FIT from the GPT partition whose
+# PARTUUID equals the `kern_guid` in the kernel command line. Ensuring that
+# partition holds the current kernel is the platform boot package's setup-boot
+# entrypoint (omarchy-google-boot, resolved from kern_guid); this leaf only
+# guarantees the tools it needs are present.
+if omarchy-hw-aarch64-google; then
+  omarchy-pkg-add vboot-utils depthcharge-tools
+fi
diff --git a/install/hardware/google/firmware.sh b/install/hardware/google/firmware.sh
new file mode 100644
index 0000000..e634fdd
--- /dev/null
+++ b/install/hardware/google/firmware.sh
@@ -0,0 +1,8 @@
+# Google Chrome OS (aarch64-google) firmware.
+#
+# Arch Linux ARM splits linux-firmware by vendor; MediaTek carries the MT8192
+# SCP images and Realtek the RTW88 Wi-Fi and Bluetooth blobs, and the base
+# package does not pull either in.
+if omarchy-hw-aarch64-google; then
+  omarchy-pkg-add linux-firmware-mediatek linux-firmware-realtek
+fi
