@@ -100,6 +100,13 @@ fi
 # generic setup and installs. Moving an operation to required also changes
 # apple_optional in test/shell.d/lifecycle-dispatch-test.sh and the Apple column
 # and registration table in docs/lifecycle-dispatch.md.
+#
+# Google Chrome OS devices (aarch64-google) boot a signed depthcharge FIT from
+# their GPT kernel partition, which the generic Limine path cannot drive, so
+# their boot package owns setup-boot and update-verify. Provisioning, factory
+# reset and luks-slots stay no-ops: this platform has no LUKS, so the generic
+# paths have nothing to do. System setup and the app-install hooks live in the
+# runtime package and are optional, like the Mac's.
 case $platform:$operation in
   aarch64-apple:setup-system | aarch64-apple:setup-user | aarch64-apple:post-install | aarch64-apple:pre-remove)
     implementation=/usr/lib/omarchy/mac
@@ -117,6 +124,19 @@ case $platform:$operation in
       setup-boot
     )
     ;;
+  aarch64-google:setup-system | aarch64-google:setup-user | aarch64-google:post-install | aarch64-google:pre-remove)
+    implementation=/usr/lib/omarchy/google
+    package=omarchy-google
+    required=()
+    ;;
+  aarch64-google:*)
+    implementation=/usr/lib/omarchy/google-boot
+    package=omarchy-google-boot
+    required=(
+      update-verify
+      setup-boot
+    )
+    ;;
   *)
     exit 0
     ;;
