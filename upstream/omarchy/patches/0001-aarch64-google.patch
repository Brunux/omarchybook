index 0000000..47ed093
--- /dev/null
+++ b/install/hardware/google/keyboard.sh
@@ -0,0 +1,10 @@
+# Google Chrome OS (aarch64-google) keyboard.
+#
+# The Chromebook action row emits KEY_BACK/FORWARD/REFRESH/FULL_SCREEN/SCALE and
+# brightness/mute/volume keys, so switching VTs needs real F-key keycodes that
+# keyd supplies. The device-specific mapping (and the cros_ec_buttons / headset
+# jack exclusions, which share the keyboard's 0000:0000 id) is hardware-specific
+# and ships with the platform package, not here.
+if omarchy-hw-aarch64-google; then
+  omarchy-pkg-add keyd
+fi
